// use prisma-8

model User {
  id        ObjectId             @id @map("_id")
  email     String               @unique
  username  String?
  name      String?
  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  @@map("users")
}

model Object {
  id ObjectId @id @map("_id")

  @@map("objects")
}

model Organization {
  id   ObjectId @id @map("_id")
  name String

  @@map("organizations")
}

model Field {
  id   ObjectId @id @map("_id")
  name String

  @@map("fields")
}
